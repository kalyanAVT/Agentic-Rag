# =============================================================================
# Agentic RAG -- Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values. Never commit .env itself.
#   cp .env.example .env
# =============================================================================

# --- LLM Provider (any OpenAI-compatible API) ---
# The pipeline uses the OpenAI SDK, so it works with OpenAI, OpenRouter, xAI Grok,
# or any OpenAI-compatible endpoint -- switching providers is pure config, no code
# change. With the sk-change-me placeholder below (and no LLM_API_KEY), the agent
# runs fully offline on deterministic fallbacks, so `make demo` always works.
OPENAI_API_KEY=sk-change-me
#
# To use a free/alternate provider, set the vars below.
# LLM_API_KEY overrides OPENAI_API_KEY; leave LLM_BASE_URL unset for plain OpenAI.
#   OpenRouter:  https://openrouter.ai/api/v1
#     - openrouter/free      auto-routes across many free backends (recommended:
#                            spreads load, avoids any single provider's rate limit)
#     - or pin one model, e.g. google/gemini-2.0-flash-exp:free
#   xAI Grok:    https://api.x.ai/v1            e.g. grok-2-latest
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=gpt-4o-mini
#
# Optional resilience knobs (defaults shown). A bounded per-request timeout means
# a slow/stuck provider degrades to the offline fallback instead of hanging.
# LLM_TIMEOUT=30
# LLM_MAX_RETRIES=1

# --- GitHub (data source) ---
# Use a fine-grained PAT scoped to a demo repo you control (see docs/PROJECT_BRIEF.md).
# Leave these as the sentinels below to run entirely on mock seed data.
GITHUB_TOKEN=ghp_change-me
GITHUB_REPO=your-username/demo-project-x

# --- GitHub access mode (Phase 3) ---
# Live modes require a REAL GITHUB_TOKEN and a GITHUB_REPO you control; with the
# sentinel values above, the agent always uses mock seed data regardless of mode.
# "none"   = always use mock seed data (offline demo -- Phase 1/2 behavior)
# "rest"   = live GitHub via PyGithub REST API
# "docker" = local GitHub MCP container (ghcr.io/github/github-mcp-server) *
# "remote" = GitHub's hosted MCP at api.githubcopilot.com/mcp/ *
# * MCP transport is not yet wired -- docker/remote currently use the REST API.
GITHUB_MCP_MODE=none

# --- Observability (Phase 5) ---
# Every run's structured Trace is ALWAYS persisted as JSON under TRACE_DIR and is
# retrievable from the API (GET /runs, GET /runs/{run_id}) with no third-party
# account -- this is the self-contained half of observability, and it needs no
# config. Override the location only if you want to:
# TRACE_DIR=traces
#
# Optionally ALSO ship each run to a hosted dashboard. Langfuse is the recommended
# backend (open-source, free cloud tier, self-hostable -- fits the deploy story).
# Set BOTH keys to real values to enable; leave them commented / at the sk-lf- /
# pk-lf- placeholders to stay fully offline (the hook is a no-op, `make demo`
# needs no key).
#   Langfuse (recommended): sign up at https://cloud.langfuse.com  (or self-host)
# LANGFUSE_PUBLIC_KEY=pk-lf-change-me
# LANGFUSE_SECRET_KEY=sk-lf-change-me
# LANGFUSE_HOST=https://cloud.langfuse.com
#
# Alternative backend: LangSmith (SaaS; works for non-LangChain apps via the
# @traceable decorator / Client API). Not wired by default.
# LANGSMITH_API_KEY=ls-change-me
