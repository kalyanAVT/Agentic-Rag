# =============================================================================
# Agentic RAG -- Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values. Never commit .env itself.
#   cp .env.example .env
# =============================================================================

# --- LLM Provider ---
OPENAI_API_KEY=sk-change-me

# --- GitHub (data source) ---
# Use a fine-grained PAT scoped to a demo repo you control (see docs/PROJECT_BRIEF.md).
# Leave these as the sentinels below to run entirely on mock seed data.
GITHUB_TOKEN=ghp_change-me
GITHUB_REPO=your-username/demo-project-x

# --- GitHub access mode (Phase 3) ---
# Live modes require a REAL GITHUB_TOKEN and a GITHUB_REPO you control; with the
# sentinel values above, the agent always uses mock seed data regardless of mode.
# "none"   = always use mock seed data (offline demo -- Phase 1/2 behavior)
# "rest"   = live GitHub via PyGithub REST API
# "docker" = local GitHub MCP container (ghcr.io/github/github-mcp-server) *
# "remote" = GitHub's hosted MCP at api.githubcopilot.com/mcp/ *
# * MCP transport is not yet wired -- docker/remote currently use the REST API.
GITHUB_MCP_MODE=none

# --- Observability (Phase 5) ---
# Pick one: LangSmith or Langfuse
LANGSMITH_API_KEY=ls-change-me
# LANGFUSE_SECRET_KEY=sk-lf-change-me
# LANGFUSE_PUBLIC_KEY=pk-lf-change-me
# LANGFUSE_HOST=https://cloud.langfuse.com
